# ── Supabase (server: ingestion CLI) ────────────────────────────────────────
# Local dev values come from `supabase start` output (Docker required).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # ingestion only; bypasses RLS; NEVER shipped to the browser

# ── Supabase (browser/web: public reads via the anon key) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── GitHub (public_repo PAT — higher rate limit for the releases adapter) ───
GITHUB_TOKEN=

# ── LLM enrichment (bring your own key) — all optional; unset = graceful skip
# Generation (per-item LLM summaries). Unset → the enrich stage skips.
LLM_PROVIDER=                     # anthropic | openai | fake (fake = deterministic, no key, for dev/tests)
ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # required when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai
LLM_MODEL_BULK=                   # bulk/enrichment model override (default: claude-haiku-4-5 / gpt-4o-mini)
LLM_MODEL_DRAFT=                  # high-quality generation tier override (default: claude-opus-4-8 / gpt-4o)

# Embeddings (semantic search / clustering assist). Unset → embed stage skips.
EMBEDDINGS_PROVIDER=              # voyage | openai | fake
VOYAGE_API_KEY=                   # required when EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=                 # override (default: voyage-3.5-lite / text-embedding-3-small @1024 dims)

# Budget cap: max items enriched/embedded per run (cap-and-continue).
LLM_MAX_ITEMS_PER_RUN=            # default 400

# Clustering semantic assist (needs live embeddings — leave off until calibrated).
CLUSTER_SEMANTIC=                 # 1 = blend embedding cosine into title similarity (default off)

# ── Dev knobs ───────────────────────────────────────────────────────────────
INGEST_LIMIT_SOURCES=             # comma-separated slugs, e.g. fake-fixture or rss-openai
