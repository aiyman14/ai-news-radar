# Nothing here is required. The radar runs with zero configuration.

# ── GitHub (public_repo PAT — higher rate limit for the releases adapter) ───
GITHUB_TOKEN=

# ── Ingest knobs ────────────────────────────────────────────────────────────
RADAR_SNAPSHOT=                   # snapshot path (default <repo>/data/radar.json)
RADAR_WINDOW_DAYS=                # keep items published within N days (default 14; 0 = everything)
INGEST_LIMIT_SOURCES=             # comma-separated slugs, e.g. fake-fixture or rss-openai

# ── Web build ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=            # "/<repo>" on a GitHub Pages project site; empty for local dev

# ── LLM enrichment (bring your own key) — all optional; unset = graceful skip
LLM_PROVIDER=                     # anthropic | openai | fake (fake = deterministic, no key)
ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # required when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai
LLM_MODEL_BULK=                   # bulk/enrichment model override
LLM_MODEL_DRAFT=                  # high-quality generation tier override
EMBEDDINGS_PROVIDER=              # voyage | openai | fake
VOYAGE_API_KEY=                   # required when EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=                 # override
LLM_MAX_ITEMS_PER_RUN=            # default 400
CLUSTER_SEMANTIC=                 # 1 = blend embedding cosine into title similarity (default off)
